{
  "window": {
    "title": "EcoVis",
    "width": 1920,
    "height": 1080,
    "enable_ui_scaling": false,
    "show_fps": false
  },

  "theme": "dark",

  "opengl": {
    "debug": false
  },

  "graphics": {
    "default_fov": 45.0,
    "tile_gpu_cache_size" : 1024,
    "power_plant_scale" : 3.0,
    "msaa_enabled": true,
    "ambient": 0.1,
    "shadow_map_resolution": 2048,
    "shadow_cascade_count": 4
  },

  "input": {
    "key_step_size": 1.0,
    "mouse_sensitivity": 0.002,
    "scroll_speed": 0.4
  },

  "data_windows": {
    "save_contents": true,
    "snapshot": {
      "version": 1,
      "windows": []
    }
  },

  "keybinds": {
    "move_forward": "KEY_W",
    "move_back": "KEY_S",
    "move_left": "KEY_A",
    "move_right": "KEY_D",
    "move_up": "KEY_SPACE",
    "move_down": "KEY_LEFT_CONTROL",

    "rotate_left": "KEY_LEFT",
    "rotate_right": "KEY_RIGHT",
    "rotate_up": "KEY_UP",
    "rotate_down": "KEY_DOWN",

    "decrease_fov": "KEY_PAGE_UP",
    "increase_fov": "KEY_PAGE_DOWN",

    "toggle_fullscreen": "KEY_F11",
    "toggle_wireframe": "KEY_U"
  },
    "enabled_windows": {
        "main_menu_bar": true,
        "time_control": true,
        "debug": false,
        "config": false,
        "data": false,
        "map_weather_control": false
    }
}
